# ---------------- Core ----------------
ENV=development
DEBUG=false
# MUST change in production (JWT signing + key derivation). e.g. `openssl rand -hex 32`
SECRET_KEY=change-me-in-production-please-32bytes
# Fernet key for API-key encryption. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, it is derived from SECRET_KEY (then changing SECRET_KEY makes stored API keys unreadable).
ENCRYPTION_KEY=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------------- Storage ----------------
DATABASE_URL=mysql+pymysql://agent:agent@127.0.0.1:3306/mini_agent?charset=utf8mb4
# Local quick start without MySQL:
# DATABASE_URL=sqlite:///./data/dev.db
REDIS_URL=redis://127.0.0.1:6379/0

# Qdrant server (recommended; required when CELERY_ENABLED=true)
# QDRANT_URL=http://127.0.0.1:6333
# Otherwise embedded on-disk Qdrant (single process only):
QDRANT_PATH=./data/qdrant

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
MAX_CHAT_UPLOAD_MB=10

# ---------------- Async tasks ----------------
# true  -> document processing via Celery worker (needs Redis + Qdrant server)
# false -> in-process background threads (fine for local dev)
CELERY_ENABLED=false
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# ---------------- Admin bootstrap ----------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# ---------------- WeChat mini program ----------------
WECHAT_APPID=
WECHAT_SECRET=
# Dev only: accept any wx.login code when no AppID is configured. NEVER enable in production.
WECHAT_DEV_LOGIN=true

# ---------------- LLM ----------------
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=20

# Optional: seed a default model on first init (otherwise add it in the admin console)
# SEED_LLM_PROVIDER=deepseek
# SEED_LLM_API_KEY=sk-xxx
# SEED_LLM_CHAT_MODEL=deepseek-chat
