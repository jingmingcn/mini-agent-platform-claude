.text { white-space: pre-wrap; word-break: break-word; line-height: 1.7; }
.atts { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 10rpx; }
.att-img { width: 180rpx; height: 180rpx; border-radius: 12rpx; }
.att-file { background: rgba(255,255,255,.6); border: 1px solid #e5e7eb; border-radius: 10rpx; padding: 8rpx 16rpx; font-size: 24rpx; color: #374151; }
.img { width: 100%; border-radius: 12rpx; }
.err { color: #dc2626; background: #fef2f2; padding: 12rpx 16rpx; border-radius: 10rpx; font-size: 26rpx; }
.tbl { display: table; border-collapse: collapse; font-size: 24rpx; }
.tr { display: table-row; } .th { font-weight: 600; background: #f8fafc; }
.td { display: table-cell; border: 1px solid #e5e7eb; padding: 8rpx 14rpx; }
.card-msg { border: 1px solid #e5e7eb; border-radius: 14rpx; padding: 18rpx; } .card-title { font-weight: 600; margin-bottom: 6rpx; }
