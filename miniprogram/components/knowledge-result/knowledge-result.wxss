.kr { margin-top: 16rpx; border-top: 1px dashed #e5e7eb; padding-top: 12rpx; }
.kr-head { display: flex; justify-content: space-between; font-size: 24rpx; color: #4b5563; }
.arrow { color: #3b5bfd; }
.item { background: #f8fafc; border-radius: 12rpx; padding: 14rpx 16rpx; margin-top: 12rpx; }
.title { display: flex; align-items: center; gap: 10rpx; font-size: 25rpx; }
.no { background: #3b5bfd; color: #fff; border-radius: 6rpx; padding: 0 10rpx; font-size: 20rpx; }
.name { flex: 1; font-weight: 600; }
.meta { color: #8a919f; font-size: 22rpx; }
.kb { margin: 4rpx 0; }
.snippet { font-size: 24rpx; color: #4b5563; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.snippet.full { display: block; -webkit-line-clamp: unset; }
