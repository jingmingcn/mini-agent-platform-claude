.loading { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 0; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #3b5bfd; animation: blink 1.2s infinite ease-in-out; }
.d2 { animation-delay: .2s; } .d3 { animation-delay: .4s; }
.txt { color: #8a919f; font-size: 24rpx; margin-left: 8rpx; }
@keyframes blink { 0%, 80%, 100% { opacity: .2; transform: scale(.8); } 40% { opacity: 1; transform: scale(1); } }
