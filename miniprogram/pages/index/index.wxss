.hero { background: linear-gradient(135deg, #3b5bfd, #6d28d9); color: #fff; border-radius: 24rpx; padding: 40rpx 32rpx; }
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { margin-top: 12rpx; opacity: .9; line-height: 1.6; }
.featured { white-space: nowrap; }
.f-card { display: inline-block; width: 260rpx; background: #fff; border-radius: 20rpx; padding: 24rpx; margin-right: 18rpx; vertical-align: top; white-space: normal; }
.f-avatar { font-size: 56rpx; }
.f-name { font-weight: 600; margin-top: 10rpx; }
.f-desc { color: #8a919f; font-size: 22rpx; margin-top: 6rpx; height: 64rpx; overflow: hidden; line-height: 32rpx; }
.quick { display: flex; flex-wrap: wrap; gap: 14rpx; }
.q { background: #fff; border-radius: 999rpx; padding: 12rpx 24rpx; font-size: 24rpx; color: #3b5bfd; border: 1px solid #e0e7ff; }
